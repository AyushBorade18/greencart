# Copy this file to  .env  (for your computer) and fill it in.
# On Vercel, type the same names and values in:
#   Project > Settings > Environment Variables

# ---- Website --------------------------------------------------------
# Any long random text. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- MySQL ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=greencart
# Cloud MySQL (Aiven, TiDB, Railway ...) needs this set to true
DB_SSL=false

# ---- Supabase (login + product pictures) ---------------------------
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=product-images

# The public web address of your site (used in the confirmation email link).
#   local:   http://127.0.0.1:5000
#   Vercel:  https://your-app.vercel.app
SITE_URL=http://127.0.0.1:5000

# true  = people must click the link in the confirmation email
# false = no email step (only for testing)
REQUIRE_EMAIL_CONFIRMATION=true

# ---- Shop rules ------------------------------------------------------
STORE_NAME=GreenCart
DELIVERY_FEE=40
FREE_DELIVERY_ABOVE=499
RETURN_WINDOW_DAYS=7

# ---- Order emails (optional) -----------------------------------------
# Leave SMTP_HOST empty to switch emails OFF. Works with Gmail (app password),
# Brevo, Resend, Mailgun ... any SMTP service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Only used by scripts/setup_db.py -------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
